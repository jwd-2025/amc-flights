# Supabase — get these from your project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AviationStack — free at https://aviationstack.com (100 req/mo free, upgrade to 500/mo if needed)
# Leave blank to disable automatic flight lookup
VITE_AVIATIONSTACK_KEY=your-api-key

# Used only by Netlify scheduled function (server-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AVIATIONSTACK_KEY=your-api-key
